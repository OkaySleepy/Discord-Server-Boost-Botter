options:
  prefix: &8[&6Flagin&8]&r
  serverName: &6Flagin
  serverIP: &7play.yourserver.com

function gpsForLevel(lvl: number) :: number:
  if {_lvl} = 1:
    return 2
  if {_lvl} = 2:
    return 4
  if {_lvl} = 3:
    return 6
  if {_lvl} = 4:
    return 8
  return 10

function upgradeCost(nextlvl: number) :: number:
  if {_nextlvl} = 2:
    return 300
  if {_nextlvl} = 3:
    return 600
  if {_nextlvl} = 4:
    return 900
  if {_nextlvl} = 5:
    return 1200
  return 999999

function locKey(l: location) :: text:
  return "%name of world of {_l}%|%floor(x-coordinate of {_l})%|%floor(y-coordinate of {_l})%|%floor(z-coordinate of {_l})%"

function makeFlagItem() :: item:
  set {_i} to orange banner
  set name of {_i} to "&6Flag"
  set lore of {_i} to "&7--------------------" and "&eClaim your land" and "&7Place to generate &6Gold" and "&7Defend it from enemies" and "&7--------------------"
  return {_i}

function isFlagItem(i: item) :: boolean:
  if {_i} is orange banner:
    if name of {_i} is "&6Flag":
      if lore of {_i} contains "&eClaim your land":
        return true
  return false

function getOwnerName(u: text) :: text:
  set {_n} to "Unknown"
  loop all players:
    if "%uuid of loop-player%" is {_u}:
      set {_n} to name of loop-player
  return {_n}

function applyCombatBuff(p: player):
  set {_lvl} to {flagin.level::%uuid of {_p}%}
  if {_lvl} is not set:
    set {_lvl} to 1
  remove strength from {_p}
  if {_lvl} = 1:
    apply strength 1 to {_p} for 999999 seconds
    stop
  if {_lvl} = 2:
    apply strength 2 to {_p} for 999999 seconds
    stop
  if {_lvl} = 3:
    apply strength 3 to {_p} for 999999 seconds
    stop
  if {_lvl} = 4:
    apply strength 1 to {_p} for 999999 seconds
    stop
  apply strength 2 to {_p} for 999999 seconds

function giveCombatItem(p: player):
  set {_lvl} to {flagin.level::%uuid of {_p}%}
  if {_lvl} is not set:
    set {_lvl} to 1
  if {_lvl} <= 3:
    set {_i} to stick
    set name of {_i} to "&6Old Stick"
    set lore of {_i} to "&7Stats:" and "&7Strength &c%{_lvl}%"
    give {_p} {_i}
    stop
  if {_lvl} = 4:
    set {_i} to wooden sword
    set name of {_i} to "&6Wooden Sword"
    set lore of {_i} to "&7Stats:" and "&7Strength &c1"
    give {_p} {_i}
    stop
  set {_i} to wooden sword
  set name of {_i} to "&6Wooden Sword"
  set lore of {_i} to "&7Stats:" and "&7Strength &c2"
  give {_p} {_i}

function fillMenu(inv: inventory):
  loop 36 times:
    if slot (loop-number - 1) of {_inv} is air:
      set slot (loop-number - 1) of {_inv} to black stained glass pane named "&0 "

function fillOwnerMenuBorder(inv: inventory):
  # exact 5-row border: full top/bottom rows + side columns only
  loop 45 times:
    set {_s} to loop-number - 1
    set {_fill} to false
    if {_s} <= 8:
      set {_fill} to true
    if {_s} >= 36:
      set {_fill} to true
    if {_s} is 9:
      set {_fill} to true
    if {_s} is 17:
      set {_fill} to true
    if {_s} is 18:
      set {_fill} to true
    if {_s} is 26:
      set {_fill} to true
    if {_s} is 27:
      set {_fill} to true
    if {_s} is 35:
      set {_fill} to true
    if {_fill} is true:
      set slot {_s} of {_inv} to gray stained glass pane named "&7 "

function playFlagPlacedEffects(l: location, p: player):
  # Uses vanilla command particle for broad Skript compatibility
  execute console command "execute at %name of {_p}% run particle minecraft:cloud ~ ~1 ~ 0.35 0.25 0.35 0.01 25 force"
  execute console command "execute at %name of {_p}% run particle minecraft:cloud ~ ~1 ~ 0.35 0.25 0.35 0.01 10 force"
  play sound "entity.allay.item_given" with volume 1.2 and pitch 1.35 to {_p}

function playFlagPickupEffects(l: location, p: player):
  execute console command "execute at %name of {_p}% run particle minecraft:cloud ~ ~1 ~ 0.35 0.25 0.35 0.01 30 force"
  execute console command "execute at %name of {_p}% run particle minecraft:cloud ~ ~1 ~ 0.35 0.25 0.35 0.01 15 force"
  # don don don style
  play sound "block.note_block.basedrum" with volume 1.5 and pitch 0.65 to {_p}
  play sound "block.note_block.basedrum" with volume 1.5 and pitch 0.85 to {_p}
  play sound "block.note_block.basedrum" with volume 1.5 and pitch 1.05 to {_p}

function refreshOwnerFlagSlot(p: player, inv: inventory):
  set {_lvl} to {flagin.level::%uuid of {_p}%}
  if {_lvl} is not set:
    set {_lvl} to 1
  set {_gps} to gpsForLevel({_lvl})
  set {_g} to {flagin.gold::%uuid of {_p}%}
  if {_g} is not set:
    set {_g} to 0
  set {_cd} to {flagin.pickcooldown::%uuid of {_p}%}
  if {_cd} is not set:
    set {_cd} to 0
  set slot 22 of {_inv} to orange banner named "&6Your Flag" with lore "&7Gold: &6%{_g}%" and "&7Flag Level: &f%{_lvl}%" and "&7Income: &6%{_gps}% Gold/sec" and "" and "&eClick to pick up" and "&7Cooldown: &f%{_cd}%s"

function openFlagMenuOwner(p: player):
  set {_inv} to chest inventory with 5 rows named "&6Flag Menu"
  fillOwnerMenuBorder({_inv})
  refreshOwnerFlagSlot({_p}, {_inv})
  set slot 10 of {_inv} to cut sandstone named "&6Blocks" with lore "&7Buy blocks to defend" and "" and "&eClick to open"
  set slot 11 of {_inv} to chainmail chestplate named "&6Armor" with lore "&7Upgrade your armor" and "" and "&eClick to open"
  set slot 15 of {_inv} to wooden sword named "&6Weapon" with lore "&7Get your current weapon" and "" and "&eClick to receive"
  set slot 16 of {_inv} to potion named "&6Upgrade Flag" with lore "&7Upgrade income level" and "" and "&eClick to open"
  set slot 19 of {_inv} to feather named "&6Custom Items" with lore "&7Coming soon"
  set slot 25 of {_inv} to crossbow named "&6Bow Gadgets" with lore "&7Coming soon"
  set slot 31 of {_inv} to barrier named "&cExit" with lore "&7Click to close"
  open {_inv} to {_p}

function openFlagMenuOther(p: player, ownerName: text):
  set {_inv} to chest inventory with 4 rows named "&6Flag Info"
  fillMenu({_inv})
  set slot 22 of {_inv} to orange banner named "&6Flag" with lore "&6⚑ &cThis is not your flag" and "&7It belongs to: &e%{_ownerName}%"
  set slot 31 of {_inv} to barrier named "&cExit" with lore "&7Click to close"
  open {_inv} to {_p}

function openBlockShop(p: player):
  set {_inv} to chest inventory with 4 rows named "&6Blocks"
  fillMenu({_inv})
  set slot 10 of {_inv} to sandstone named "&6Sandstone" with lore "&7Price: &e80 Gold" and "" and "&eClick to buy"
  set slot 11 of {_inv} to yellow terracotta named "&6Yellow Terracotta" with lore "&7Price: &e260 Gold" and "" and "&eClick to buy"
  set slot 12 of {_inv} to brown terracotta named "&6Brown Terracotta" with lore "&7Price: &e410 Gold" and "" and "&eClick to buy"
  set slot 13 of {_inv} to gray terracotta named "&6Gray Terracotta" with lore "&7Price: &e900 Gold" and "" and "&eClick to buy"
  set slot 14 of {_inv} to light gray stained glass named "&6Light Gray Glass" with lore "&7Price: &e1900 Gold" and "" and "&eClick to buy"
  set slot 15 of {_inv} to gray stained glass named "&6Gray Glass" with lore "&7Price: &e2600 Gold" and "" and "&eClick to buy"
  set slot 16 of {_inv} to dried kelp block named "&6Dried Kelp Block" with lore "&7Price: &e150 Gold" and "" and "&eClick to buy"
  set slot 19 of {_inv} to glowstone named "&6Glowstone" with lore "&7Price: &e600 Gold" and "" and "&eClick to buy"
  set slot 20 of {_inv} to cobweb named "&6Cobweb" with lore "&7Price: &e800 Gold" and "" and "&eClick to buy"
  set slot 31 of {_inv} to arrow named "&aBack" with lore "&7Return to menu"
  set slot 35 of {_inv} to barrier named "&cExit" with lore "&7Click to close"
  open {_inv} to {_p}

function openArmorUpgrades(p: player):
  set {_inv} to chest inventory with 4 rows named "&6Armor"
  fillMenu({_inv})
  set {_tier} to {flagin.armor::%uuid of {_p}%}
  if {_tier} is not set:
    set {_tier} to 0
  if {_tier} < 1:
    set slot 10 of {_inv} to barrier named "&cUnlock The First Armor" with lore "&7Buy Wooden Armor first"
  set slot 13 of {_inv} to leather chestplate named "&6Wooden Armor" with lore "&7Cost: &e200 Gold" and "" and "&eClick to buy"
  set slot 15 of {_inv} to chainmail chestplate named "&6Chainmail Armor" with lore "&7Cost: &e600 Gold" and "" and "&eClick to buy"
  set slot 17 of {_inv} to chainmail chestplate named "&6Chainmail Armor &7(Prot I)" with lore "&7Cost: &e1200 Gold" and "" and "&eClick to buy"
  set slot 31 of {_inv} to arrow named "&aBack" with lore "&7Return to menu"
  set slot 35 of {_inv} to barrier named "&cExit" with lore "&7Click to close"
  open {_inv} to {_p}

function openFlagUpgrader(p: player):
  set {_inv} to chest inventory with 4 rows named "&6Upgrade Flag"
  fillMenu({_inv})
  set {_lvl} to {flagin.level::%uuid of {_p}%}
  if {_lvl} is not set:
    set {_lvl} to 1
  set {_gps} to gpsForLevel({_lvl})
  if {_lvl} >= 5:
    set slot 13 of {_inv} to orange banner named "&6Flag Upgrader" with lore "&7Flag Level: &f%{_lvl}%" and "&7Income: &6%{_gps}% Gold/sec" and "" and "&aMax Level"
  else:
    set {_next} to {_lvl} + 1
    set {_cost} to upgradeCost({_next})
    set slot 13 of {_inv} to orange banner named "&6Flag Upgrader" with lore "&7Flag Level: &f%{_lvl}%" and "&7Income: &6%{_gps}% Gold/sec" and "" and "&7Upgrade Cost: &e%{_cost}% Gold" and "&eClick to upgrade"
  set slot 31 of {_inv} to arrow named "&aBack" with lore "&7Return to menu"
  set slot 35 of {_inv} to barrier named "&cExit" with lore "&7Click to close"
  open {_inv} to {_p}

function isPlacedFlagBlock(l: location) :: boolean:
  if block at {_l} is orange banner:
    return true
  if block at {_l} is orange wall banner:
    return true
  return false

function cleanupOwnerByLoc(l: location):
  set {_k} to locKey({_l})
  if {flagin.owner::%{_k}%} is set:
    set {_u} to {flagin.owner::%{_k}%}
    delete {flagin.owner::%{_k}%}
    delete {flagin.breaking::%{_k}%}
    delete {flagin.flagloc::%{_u}%}
    remove {_u} parsed as uuid from {flagin.flagowners::*}

function requestPickupFlag(p: player) :: boolean:
  if {flagin.pickpending::%uuid of {_p}%} is true:
    send action bar "&cFlag pickup already in progress..." to {_p}
    return false
  if {flagin.flagloc::%uuid of {_p}%} is not set:
    return false
  set {_loc} to {flagin.flagloc::%uuid of {_p}%}
  set {_k} to locKey({_loc})
  if {flagin.owner::%{_k}%} is not set:
    return false
  if "%{flagin.owner::%{_k}%}%" is not "%uuid of {_p}%":
    return false
  if {flagin.breaking::%{_k}%} is set:
    return false
  set {_cd} to {flagin.pickcooldown::%uuid of {_p}%}
  if {_cd} is not set:
    set {_cd} to 0
  if {_cd} > 0:
    send action bar "&cFlag pickup cooldown: &f%{_cd}%s" to {_p}
    return false
  set {flagin.pickpending::%uuid of {_p}%} to true
  set {flagin.pickcooldown::%uuid of {_p}%} to 3
  send action bar "&ePicking up flag in &f3s&e..." to {_p}
  return true

function tryPickupFlag(p: player, bypassCooldown: boolean = false) :: boolean:
  if {flagin.flagloc::%uuid of {_p}%} is not set:
    return false
  set {_loc} to {flagin.flagloc::%uuid of {_p}%}
  set {_k} to locKey({_loc})
  if {flagin.owner::%{_k}%} is not set:
    delete {flagin.flagloc::%uuid of {_p}%}
    remove uuid of {_p} from {flagin.flagowners::*}
    return false
  if "%{flagin.owner::%{_k}%}%" is not "%uuid of {_p}%":
    delete {flagin.flagloc::%uuid of {_p}%}
    remove uuid of {_p} from {flagin.flagowners::*}
    return false
  if {flagin.breaking::%{_k}%} is set:
    return false
  if {_bypassCooldown} is false:
    set {_cd} to {flagin.pickcooldown::%uuid of {_p}%}
    if {_cd} is not set:
      set {_cd} to 0
    if {_cd} > 0:
      send action bar "&cFlag pickup cooldown: &f%{_cd}%s" to {_p}
      return false
  if isPlacedFlagBlock({_loc}) is true:
    playFlagPickupEffects({_loc}, {_p})
    set block at {_loc} to air
  cleanupOwnerByLoc({_loc})
  delete {flagin.pickpending::%uuid of {_p}%}
  give {_p} makeFlagItem()
  return true

function updateBoard(p: player):
  toggle fastboard of {_p} to on
  set title of {_p}'s fastboard to "{@serverName}"
  set {_g} to {flagin.gold::%uuid of {_p}%}
  if {_g} is not set:
    set {_g} to 0
  set {_lvl} to {flagin.level::%uuid of {_p}%}
  if {_lvl} is not set:
    set {_lvl} to 1
  set {_k} to {flagin.kills::%uuid of {_p}%}
  if {_k} is not set:
    set {_k} to 0
  set {_d} to {flagin.deaths::%uuid of {_p}%}
  if {_d} is not set:
    set {_d} to 0
  set line 1 of {_p}'s fastboard to "&7 "
  set line 2 of {_p}'s fastboard to "&eGold: &f%{_g}%"
  set line 3 of {_p}'s fastboard to "&eFlag Level: &f%{_lvl}%"
  set line 4 of {_p}'s fastboard to "&eKills: &f%{_k}%"
  set line 5 of {_p}'s fastboard to "&eDeaths: &f%{_d}%"
  set line 6 of {_p}'s fastboard to "&7  "
  set line 7 of {_p}'s fastboard to "{@serverIP}"

command /flagin [<text>]:
  trigger:
    if player does not have permission "Flagin.FlagAllPerms":
      if player does not have permission "Flagin.Flag":
        send "{@prefix} &cNo permission." to player
        stop
    if arg-1 is not set:
      give player makeFlagItem()
      send "{@prefix} &aYou received a &6Flag&a." to player
      stop
    if arg-1 is "fix":
      if player does not have permission "Flagin.FlagAllPerms":
        send "{@prefix} &cNo permission." to player
        stop
      if tryPickupFlag(player, true) is true:
        send "{@prefix} &aFixed and returned your flag." to player
      else:
        send "{@prefix} &cNothing to fix." to player
      stop
    if arg-1 is "debug":
      if player does not have permission "Flagin.FlagAllPerms":
        send "{@prefix} &cNo permission." to player
        stop
      set {_g} to {flagin.gold::%uuid of player%}
      if {_g} is not set:
        set {_g} to 0
      set {_lvl} to {flagin.level::%uuid of player%}
      if {_lvl} is not set:
        set {_lvl} to 1
      set {_cd} to {flagin.pickcooldown::%uuid of player%}
      if {_cd} is not set:
        set {_cd} to 0
      send "{@prefix} &7Gold: &6%{_g}% &8| &7Level: &6%{_lvl}% &8| &7GPS: &6%gpsForLevel({_lvl})% &8| &7PickupCD: &6%{_cd}%s" to player
      if {flagin.flagloc::%uuid of player%} is set:
        send "{@prefix} &7FlagLoc: &f%{flagin.flagloc::%uuid of player%}%" to player
      else:
        send "{@prefix} &7FlagLoc: &cNone" to player
      stop
    send "{@prefix} &7Usage: &e/flagin &8| &e/flagin fix &8| &e/flagin debug" to player

command /flaginremove <player>:
  trigger:
    if player does not have permission "Flagin.FlagAllPerms":
      send "{@prefix} &cNo permission." to player
      stop
    set {_t} to arg-1
    if {flagin.flagloc::%uuid of {_t}%} is not set:
      send "{@prefix} &cThat player has no flag placed." to player
      stop
    set {_loc} to {flagin.flagloc::%uuid of {_t}%}
    if isPlacedFlagBlock({_loc}) is true:
      set block at {_loc} to air
    cleanupOwnerByLoc({_loc})
    send "{@prefix} &aRemoved %name of {_t}%'s flag." to player
    send "{@prefix} &cYour flag was removed by an admin." to {_t}

command /stick:
  trigger:
    if player does not have permission "Flagin.Stick":
      if player does not have permission "Flagin.FlagAllPerms":
        send "{@prefix} &cNo permission." to player
        stop
    giveCombatItem(player)

on load:
  broadcast ""
  broadcast "&6Flagin &7Core reloaded &8| &7Made By KunLeo"
  broadcast ""

on join:
  if {flagin.gold::%uuid of player%} is not set:
    set {flagin.gold::%uuid of player%} to 0
  if {flagin.level::%uuid of player%} is not set:
    set {flagin.level::%uuid of player%} to 1
  if {flagin.armor::%uuid of player%} is not set:
    set {flagin.armor::%uuid of player%} to 0
  if {flagin.pickcooldown::%uuid of player%} is not set:
    set {flagin.pickcooldown::%uuid of player%} to 0
  if {flagin.kills::%uuid of player%} is not set:
    set {flagin.kills::%uuid of player%} to 0
  if {flagin.deaths::%uuid of player%} is not set:
    set {flagin.deaths::%uuid of player%} to 0
  applyCombatBuff(player)
  updateBoard(player)

on quit:
  clear fastboard of player

on death of player:
  add 1 to {flagin.deaths::%uuid of victim%}
  if attacker is a player:
    add 1 to {flagin.kills::%uuid of attacker%}
    set {_g} to {flagin.gold::%uuid of victim%}
    if {_g} is not set:
      set {_g} to 0
    set {_loss} to floor({_g} * 0.25)
    if {_loss} > 0:
      remove {_loss} from {flagin.gold::%uuid of victim%}
      add {_loss} to {flagin.gold::%uuid of attacker%}
      send "{@prefix} &cYou died and lost &e%{_loss}%&c gold." to victim
      send "{@prefix} &aYou gained &e%{_loss}%&a gold." to attacker
  wait 1 tick
  updateBoard(victim)
  if attacker is a player:
    updateBoard(attacker)

on block damage:
  if event-block is orange banner:
    set {_l} to location of event-block
    set {_k} to locKey({_l})
    if {flagin.owner::%{_k}%} is set:
      set {_o} to {flagin.owner::%{_k}%}
      if "%uuid of player%" is not "%{_o}%":
        set {flagin.breaking::%{_k}%} to true
        wait 4 seconds
        delete {flagin.breaking::%{_k}%}
  if event-block is orange wall banner:
    set {_l} to location of event-block
    set {_k} to locKey({_l})
    if {flagin.owner::%{_k}%} is set:
      set {_o} to {flagin.owner::%{_k}%}
      if "%uuid of player%" is not "%{_o}%":
        set {flagin.breaking::%{_k}%} to true
        wait 4 seconds
        delete {flagin.breaking::%{_k}%}

on place:
  if isFlagItem(event-item) is true:
    set {_l} to location of event-block
    set {_key} to locKey({_l})
    if {flagin.owner::%{_key}%} is set:
      cancel event
      send "{@prefix} &cA flag is already here." to player
      stop
    if {flagin.flagloc::%uuid of player%} is set:
      cancel event
      send "{@prefix} &cYou already have a placed flag." to player
      stop
    set {flagin.owner::%{_key}%} to uuid of player
    set {flagin.flagloc::%uuid of player%} to {_l}
    add uuid of player to {flagin.flagowners::*}
    playFlagPlacedEffects({_l}, player)
    send "{@prefix} &aYour flag has been placed!" to player
    updateBoard(player)

on right click:
  if clicked block is orange banner:
    set {_l} to location of clicked block
    set {_key} to locKey({_l})
    if {flagin.owner::%{_key}%} is not set:
      stop
    set {_ownerUuid} to {flagin.owner::%{_key}%}
    cancel event
    if "%uuid of player%" is "%{_ownerUuid}%":
      if player is sneaking:
        if requestPickupFlag(player) is true:
          send "{@prefix} &ePicking up... &f3s" to player
          updateBoard(player)
        else:
          send "{@prefix} &cYou cannot pick it up right now." to player
        stop
      openFlagMenuOwner(player)
      stop
    set {_ownerName} to getOwnerName("%{_ownerUuid}%")
    send "{@prefix} &6⚑ &cThis is not your flag it belongs to &e%{_ownerName}%&c." to player
    openFlagMenuOther(player, {_ownerName})

  if clicked block is orange wall banner:
    set {_l} to location of clicked block
    set {_key} to locKey({_l})
    if {flagin.owner::%{_key}%} is not set:
      stop
    set {_ownerUuid} to {flagin.owner::%{_key}%}
    cancel event
    if "%uuid of player%" is "%{_ownerUuid}%":
      if player is sneaking:
        if requestPickupFlag(player) is true:
          send "{@prefix} &ePicking up... &f3s" to player
          updateBoard(player)
        else:
          send "{@prefix} &cYou cannot pick it up right now." to player
        stop
      openFlagMenuOwner(player)
      stop
    set {_ownerName} to getOwnerName("%{_ownerUuid}%")
    send "{@prefix} &6⚑ &cThis is not your flag it belongs to &e%{_ownerName}%&c." to player
    openFlagMenuOther(player, {_ownerName})

on inventory click:
  if name of event-inventory is "&6Flag Info":
    cancel event
    if event-item is air:
      stop
    if name of event-item is "&cExit":
      close player's inventory
    stop

  if name of event-inventory is "&6Flag Menu":
    cancel event
    if event-item is air:
      stop
    refreshOwnerFlagSlot(player, event-inventory)
    set {_n} to name of event-item
    if {_n} is "&cExit":
      close player's inventory
      stop
    if {_n} is "&6Blocks":
      openBlockShop(player)
      stop
    if {_n} is "&6Armor":
      openArmorUpgrades(player)
      stop
    if {_n} is "&6Upgrade Flag":
      openFlagUpgrader(player)
      stop
    if {_n} is "&6Weapon":
      giveCombatItem(player)
      stop
    if {_n} is "&6Your Flag":
      if requestPickupFlag(player) is true:
        send "{@prefix} &ePicking up... &f3s" to player
        close player's inventory
        updateBoard(player)
      else:
        send "{@prefix} &cYou cannot pick it up right now." to player
      stop

  if name of event-inventory is "&6Blocks":
    cancel event
    if event-item is air:
      stop
    set {_n} to name of event-item
    if {_n} is "&aBack":
      openFlagMenuOwner(player)
      stop
    if {_n} is "&cExit":
      close player's inventory
      stop
    set {_price} to 0
    set {_give} to air
    if {_n} is "&6Sandstone":
      set {_price} to 80
      set {_give} to sandstone
    if {_n} is "&6Yellow Terracotta":
      set {_price} to 260
      set {_give} to yellow terracotta
    if {_n} is "&6Brown Terracotta":
      set {_price} to 410
      set {_give} to brown terracotta
    if {_n} is "&6Gray Terracotta":
      set {_price} to 900
      set {_give} to gray terracotta
    if {_n} is "&6Light Gray Glass":
      set {_price} to 1900
      set {_give} to light gray stained glass
    if {_n} is "&6Gray Glass":
      set {_price} to 2600
      set {_give} to gray stained glass
    if {_n} is "&6Dried Kelp Block":
      set {_price} to 150
      set {_give} to dried kelp block
    if {_n} is "&6Glowstone":
      set {_price} to 600
      set {_give} to glowstone
    if {_n} is "&6Cobweb":
      set {_price} to 800
      set {_give} to cobweb
    if {_price} <= 0:
      stop
    if {flagin.gold::%uuid of player%} < {_price}:
      send "{@prefix} &cNot enough gold." to player
      stop
    remove {_price} from {flagin.gold::%uuid of player%}
    give player 1 of {_give}
    send "{@prefix} &aPurchased for &e%{_price}%&a gold." to player
    updateBoard(player)

  if name of event-inventory is "&6Armor":
    cancel event
    if event-item is air:
      stop
    set {_n} to name of event-item
    if {_n} is "&aBack":
      openFlagMenuOwner(player)
      stop
    if {_n} is "&cExit":
      close player's inventory
      stop
    set {_tier} to {flagin.armor::%uuid of player%}
    if {_tier} is not set:
      set {_tier} to 0
    if {_n} is "&6Wooden Armor":
      if {_tier} >= 1:
        send "{@prefix} &cYou already own this." to player
        stop
      if {flagin.gold::%uuid of player%} < 200:
        send "{@prefix} &cNot enough gold." to player
        stop
      remove 200 from {flagin.gold::%uuid of player%}
      set {_c} to leather chestplate
      set name of {_c} to "&6Wooden Armor"
      give player {_c}
      set {flagin.armor::%uuid of player%} to 1
      send "{@prefix} &aArmor unlocked." to player
      updateBoard(player)
      stop
    if {_n} is "&6Chainmail Armor":
      if {_tier} < 1:
        send "{@prefix} &cUnlock previous armor first." to player
        stop
      if {_tier} >= 2:
        send "{@prefix} &cYou already own this." to player
        stop
      if {flagin.gold::%uuid of player%} < 600:
        send "{@prefix} &cNot enough gold." to player
        stop
      remove 600 from {flagin.gold::%uuid of player%}
      set {_c} to chainmail chestplate
      set name of {_c} to "&6Chainmail Armor"
      give player {_c}
      set {flagin.armor::%uuid of player%} to 2
      send "{@prefix} &aArmor unlocked." to player
      updateBoard(player)
      stop
    if {_n} is "&6Chainmail Armor &7(Prot I)":
      if {_tier} < 2:
        send "{@prefix} &cUnlock previous armor first." to player
        stop
      if {_tier} >= 3:
        send "{@prefix} &cYou already own this." to player
        stop
      if {flagin.gold::%uuid of player%} < 1200:
        send "{@prefix} &cNot enough gold." to player
        stop
      remove 1200 from {flagin.gold::%uuid of player%}
      set {_c} to chainmail chestplate
      set name of {_c} to "&6Chainmail Armor &7(Prot I)"
      enchant {_c} with protection 1
      give player {_c}
      set {flagin.armor::%uuid of player%} to 3
      send "{@prefix} &aArmor unlocked." to player
      updateBoard(player)
      stop

  if name of event-inventory is "&6Upgrade Flag":
    cancel event
    if event-item is air:
      stop
    set {_n} to name of event-item
    if {_n} is "&aBack":
      openFlagMenuOwner(player)
      stop
    if {_n} is "&cExit":
      close player's inventory
      stop
    if {_n} is "&6Flag Upgrader":
      if {flagin.upgrading::%uuid of player%} is true:
        send "{@prefix} &cYour flag is already upgrading." to player
        stop
      set {_lvl} to {flagin.level::%uuid of player%}
      if {_lvl} is not set:
        set {_lvl} to 1
      if {_lvl} >= 5:
        send "{@prefix} &aYour flag is max level." to player
        stop
      set {_next} to {_lvl} + 1
      set {_cost} to upgradeCost({_next})
      if {flagin.gold::%uuid of player%} < {_cost}:
        send "{@prefix} &cNot enough gold." to player
        stop
      remove {_cost} from {flagin.gold::%uuid of player%}
      set {flagin.upgrading::%uuid of player%} to true
      set {flagin.level::%uuid of player%} to {_next}
      set {flagin.upgrading::%uuid of player%} to false
      applyCombatBuff(player)
      openFlagUpgrader(player)
      updateBoard(player)

on break:
  if event-block is orange banner:
    set {_l} to location of event-block
    set {_key} to locKey({_l})
    if {flagin.owner::%{_key}%} is set:
      set {_owner} to {flagin.owner::%{_key}%}
      delete {flagin.breaking::%{_key}%}
      if "%uuid of player%" is "%{_owner}%":
        playFlagPickupEffects({_l}, player)
        set block at {_l} to air
        cleanupOwnerByLoc({_l})
        give player makeFlagItem()
        send "{@prefix} &aYou picked up your flag." to player
        updateBoard(player)
        stop
      set {_og} to {flagin.gold::%{_owner}%}
      if {_og} is not set:
        set {_og} to 0
      set {_take} to floor({_og} / 2)
      if {_take} > 0:
        remove {_take} from {flagin.gold::%{_owner}%}
        add {_take} to {flagin.gold::%uuid of player%}
      loop all players:
        if "%uuid of loop-player%" is "%{_owner}%":
          send "{@prefix} &cYour flag was destroyed. You lost &e%{_take}%&c gold." to loop-player
          send title "&c&lFLAG BROKEN" with subtitle "&7Your territory has fallen" to loop-player for 2 seconds
          updateBoard(loop-player)
      send "{@prefix} &aYou destroyed their flag and stole &e%{_take}%&a gold." to player
      playFlagPickupEffects({_l}, player)
      set block at {_l} to air
      cleanupOwnerByLoc({_l})
      updateBoard(player)
      give player makeFlagItem()

  if event-block is orange wall banner:
    set {_l} to location of event-block
    set {_key} to locKey({_l})
    if {flagin.owner::%{_key}%} is set:
      set {_owner} to {flagin.owner::%{_key}%}
      delete {flagin.breaking::%{_key}%}
      if "%uuid of player%" is "%{_owner}%":
        playFlagPickupEffects({_l}, player)
        set block at {_l} to air
        cleanupOwnerByLoc({_l})
        give player makeFlagItem()
        send "{@prefix} &aYou picked up your flag." to player
        updateBoard(player)
        stop
      set {_og} to {flagin.gold::%{_owner}%}
      if {_og} is not set:
        set {_og} to 0
      set {_take} to floor({_og} / 2)
      if {_take} > 0:
        remove {_take} from {flagin.gold::%{_owner}%}
        add {_take} to {flagin.gold::%uuid of player%}
      loop all players:
        if "%uuid of loop-player%" is "%{_owner}%":
          send "{@prefix} &cYour flag was destroyed. You lost &e%{_take}%&c gold." to loop-player
          send title "&c&lFLAG BROKEN" with subtitle "&7Your territory has fallen" to loop-player for 2 seconds
          updateBoard(loop-player)
      send "{@prefix} &aYou destroyed their flag and stole &e%{_take}%&a gold." to player
      playFlagPickupEffects({_l}, player)
      set block at {_l} to air
      cleanupOwnerByLoc({_l})
      updateBoard(player)
      give player makeFlagItem()

every 1 second:
  loop all players:
    set {_cd} to {flagin.pickcooldown::%uuid of loop-player%}
    if {_cd} is set:
      if {_cd} > 0:
        remove 1 from {flagin.pickcooldown::%uuid of loop-player%}
        set {_newcd} to {flagin.pickcooldown::%uuid of loop-player%}
        if {_newcd} > 0:
          send action bar "&eFlag pickup cooldown: &f%{_newcd}%s" to loop-player
          if {_newcd} = 3:
            play sound "block.note_block.basedrum" with volume 1.3 and pitch 0.6 to loop-player
          if {_newcd} = 2:
            play sound "block.note_block.basedrum" with volume 1.3 and pitch 0.5 to loop-player
          if {_newcd} = 1:
            play sound "block.note_block.basedrum" with volume 1.5 and pitch 0.4 to loop-player
        else:
          send action bar "&aFlag pickup ready!" to loop-player
          play sound "block.note_block.basedrum" with volume 1.6 and pitch 0.3 to loop-player
          if {flagin.pickpending::%uuid of loop-player%} is true:
            delete {flagin.pickpending::%uuid of loop-player%}
            if tryPickupFlag(loop-player, true) is true:
              send "{@prefix} &aYou picked up your flag." to loop-player
              updateBoard(loop-player)
            else:
              send "{@prefix} &cPickup failed (flag moved or destroyed)." to loop-player
    if name of loop-player's current inventory is "&6Flag Menu":
      refreshOwnerFlagSlot(loop-player, loop-player's current inventory)

every 2 seconds:
  loop all players:
    updateBoard(loop-player)

every 1 second:
  set {_remove::*} to ""
  loop {flagin.flagowners::*}:
    set {_u} to loop-value
    if {flagin.flagloc::%{_u}%} is set:
      set {_l} to {flagin.flagloc::%{_u}%}
      if isPlacedFlagBlock({_l}) is true:
        set {_lvl} to {flagin.level::%{_u}%}
        if {_lvl} is not set:
          set {_lvl} to 1
        add gpsForLevel({_lvl}) to {flagin.gold::%{_u}%}
      else:
        delete {flagin.flagloc::%{_u}%}
        set {_remove::%size of {_remove::*}+1%} to "%{_u}%"
    else:
      set {_remove::%size of {_remove::*}+1%} to "%{_u}%"
  loop {_remove::*}:
    if loop-value is not "":
      remove loop-value parsed as uuid from {flagin.flagowners::*}
